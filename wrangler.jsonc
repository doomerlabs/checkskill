{
  "name": "checkskill",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "checkskill.ai", "custom_domain": true }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": false, "logs": { "enabled": false }, "traces": { "enabled": false } }
}
